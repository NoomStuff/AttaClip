+static void attaclip_capture_release(ScreencastCapture *capture)
+{
+	if (--capture->references == 0) {
+		if (capture->completion) {
+			g_mutex_lock(&capture->completion->mutex);
+			capture->completion->complete = true;
+			g_cond_signal(&capture->completion->condition);
+			g_mutex_unlock(&capture->completion->mutex);
+		}
+		bfree(capture);
+	}
+}
+G_DEFINE_AUTOPTR_CLEANUP_FUNC(ScreencastCapture, attaclip_capture_release)
+static void attaclip_status(void *data, calldata_t *params)
+{
+	ScreencastCapture *capture = data;
+	calldata_set_bool(params, "authorized", atomic_load(&capture->health.authorized));
+	calldata_set_bool(params, "closed", atomic_load(&capture->health.closed));
+	calldata_set_bool(params, "failed", atomic_load(&capture->health.failed));
+	calldata_set_bool(params, "valid_frame", atomic_load(&capture->health.valid_frame));
+	calldata_set_int(params, "stream_state", atomic_load(&capture->health.stream_state));
+	calldata_set_int(params, "source_type", capture->capture_type);
+}
+static void attaclip_close_finished(GObject *source, GAsyncResult *result, gpointer data)
+{
+	g_autoptr(ScreencastCapture) capture = data;
+	g_autoptr(GError) error = NULL;
+	g_autoptr(GVariant) response = g_dbus_connection_call_finish(G_DBUS_CONNECTION(source), result, &error);
+	if (capture->destroyed) return;
+	if (error) atomic_store(&capture->health.failed, true);
+	else atomic_store(&capture->health.closed, true);
+}
+static void attaclip_close(void *data, calldata_t *params)
+{
+	UNUSED_PARAMETER(params);
+	ScreencastCapture *capture = data;
+	if (!capture->session_handle) return;
+	capture->references++;
+	g_dbus_connection_call(portal_get_dbus_connection(), "org.freedesktop.portal.Desktop",
+		capture->session_handle, "org.freedesktop.portal.Session", "Close", NULL, NULL,
+		G_DBUS_CALL_FLAGS_NONE, -1, capture->cancellable, attaclip_close_finished, capture);
+}
