+static void screencast_portal_capture_destroy(void *data)
+{
+	struct screencast_portal_capture *capture = data;
+	if (!capture) return;
+	if (g_main_context_is_owner(g_main_context_default())) {
+		attaclip_destroy_on_dispatcher(capture);
+		return;
+	}
+	/* OBS queues destruction on its worker. Portal callbacks retain their owner
+	 * until cancellation completes on the GLib dispatcher, before module unload. */
+	struct attaclip_destroy_completion completion = {0};
+	g_mutex_init(&completion.mutex);
+	g_cond_init(&completion.condition);
+	capture->completion = &completion;
+	g_mutex_lock(&completion.mutex);
+	GSource *idle = g_idle_source_new();
+	g_source_set_callback(idle, attaclip_destroy_on_dispatcher, capture, NULL);
+	g_source_attach(idle, g_main_context_default());
+	g_source_unref(idle);
+	while (!completion.complete) g_cond_wait(&completion.condition, &completion.mutex);
+	g_mutex_unlock(&completion.mutex);
+	g_cond_clear(&completion.condition);
+	g_mutex_clear(&completion.mutex);
 }
 
