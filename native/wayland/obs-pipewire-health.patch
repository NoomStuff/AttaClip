+static void attaclip_status(void *data, calldata_t *params)
+{
+	ScreencastCapture *capture = data;
+	calldata_set_bool(params, "authorized", atomic_load(&capture->health.authorized));
+	calldata_set_bool(params, "closed", atomic_load(&capture->health.closed));
+	calldata_set_bool(params, "failed", atomic_load(&capture->health.failed));
+	calldata_set_bool(params, "valid_frame", atomic_load(&capture->health.valid_frame));
+	calldata_set_int(params, "stream_state", atomic_load(&capture->health.stream_state));
+	calldata_set_int(params, "source_type", capture->capture_type);
